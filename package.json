{
  "name": "line-ai-bot",
  "version": "1.0.0",
  "description": "Kokokara LINE AI bot",
  "main": "index.js",
  "scripts": {
    "syntax:check": "node -c index.js && node -c services/conversation_state_interpreter_service.js && node -c services/topic_shift_detector_service.js && node -c services/user_daily_context_builder_service.js && node -c services/contextual_observation_selector_service.js && node -c services/human_phrase_variation_service.js && node -c services/conversation_style_profile_service.js && node -c services/image_context_classifier_service.js && node -c services/emotional_quality_check_service.js && node -c services/companion_reply_service.js && node -c services/meal_text_manual_record_service.js && node -c services/conversation_orchestrator_service.js && node -c config/meal_text_env.js && node -c scripts/lib/simulate_line_reply_quality.js && node -c scripts/simulate_line_harness.js && node -c scripts/simulate_line_observation_layer.js",
    "build": "npm run syntax:check && npm run smoke:conversation_state && npm run simulate:line && node scripts/lab_result_items_fixture_test.js",
    "start": "node index.js",
    "flags:stage-entry": "node scripts/stage_entry_flag_report.js",
    "smoke:stage-entry": "node scripts/stage_entry_smoke_inputs.js",
    "smoke:symptom-core": "node scripts/symptom_core_smoke_inputs.js",
    "smoke:homecare-core": "node scripts/homecare_core_smoke_inputs.js",
    "smoke:image-processor-load": "node scripts/image_processor_load_smoke.js",
    "smoke:lab-pipeline-compare": "node scripts/lab_pipeline_regression_compare.js",
    "smoke:lab-extract-fixtures": "node scripts/lab_extract_fixture_e2e.js",
    "smoke:lab-followup-regression": "node scripts/lab_followup_regression_cases.js",
    "smoke:phase2-migration-db": "node scripts/smoke_phase2_migration_db.js",
    "smoke:phase2-followup-intents": "node scripts/smoke_phase2_followup_intents.js",
    "smoke:lab-tentative-promotion": "node scripts/lab_tentative_promotion_regression.js",
    "smoke:v2-image-ingress": "node scripts/smoke_v2_image_ingress.js",
    "smoke:v2-repositories": "node scripts/smoke_v2_repositories.js",
    "smoke:v2-session-followup": "node scripts/smoke_v2_session_followup.js",
    "ops:phasee-verify-migration": "node scripts/phasee_verify_migration.js",
    "ops:phasee-daily-report": "node scripts/phasee_daily_reachability_report.js",
    "quality:check": "node scripts/run_conversation_quality_check.js",
    "manual:word": "node scripts/generate_word_manual.js",
    "simulate:line": "node scripts/simulate_line_harness.js",
    "simulate:line:conversation": "node scripts/simulate_line_harness.js --only=conversation",
    "simulate:line:meal-text": "node scripts/simulate_line_harness.js --only=meal",
    "simulate:line:quality": "node scripts/simulate_line_harness.js --only=meal,conversation,quality",
    "simulate:line:observation": "node scripts/simulate_line_observation_layer.js",
    "smoke:conversation_state": "node scripts/conversation_state_routing_smoke.js"
  },
  "dependencies": {
    "@google/genai": "^1.24.0",
    "@google/generative-ai": "^0.21.0",
    "@line/bot-sdk": "^9.4.0",
    "@supabase/supabase-js": "^2.98.0",
    "axios": "^1.13.5",
    "body-parser": "^1.20.3",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "google-spreadsheet": "^5.2.0",
    "multer": "^2.0.2",
    "openai": "^6.25.0",
    "sharp": "^0.34.4"
  }
}
